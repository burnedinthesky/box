{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "box",
	"account_id": "0c3d71e8e655eff35074ed4734652bf7",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/list", "/box", "/upload/*"]
	},
	"r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "box-uploads" }],
	"triggers": { "crons": ["*/15 * * * *"] },
	"observability": { "enabled": true }
}
