{
	"name": "embox",
	"version": "1.0.0",
	"description": "File sharing on Cloudflare Workers and R2 with 24-hour retention.",
	"keywords": [
		"website",
		"file"
	],
	"homepage": "https://github.com/elvisdragonmao/embox#readme",
	"bugs": {
		"url": "https://github.com/elvisdragonmao/embox/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elvisdragonmao/embox.git"
	},
	"license": "Apache-2.0",
	"author": "Elvis Mao",
	"scripts": {
		"build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "prettier --write .",
		"prepare": "husky",
		"start": "wrangler dev",
		"test": "node --test tests/*.test.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261019.1",
		"husky": "^9.1.7",
		"miniflare": "^4.20260730.0",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^5.9.3",
		"wrangler": "^4.151.3"
	},
	"packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
